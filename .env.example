# =============================================================================
# Awaitsi Business Cloud — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to Git.
# NEVER prefix backend secrets (service role key, SendGrid) with VITE_.
# =============================================================================

PORT=3001

# -----------------------------------------------------------------------------
# Supabase — Server-Side (Netlify Functions & server.mjs)
# These are NOT exposed to the browser.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service Role key bypasses RLS — ONLY use in server-side functions, NEVER in frontend
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# Supabase — Frontend / Browser (Vite exposes VITE_* vars to the client bundle)
# These are PUBLIC and appear in the compiled JS — that is intentional.
# Supabase RLS policies protect your data even with the anon key exposed.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# -----------------------------------------------------------------------------
# Email / Notifications (Server-Side Only — NEVER prefix with VITE_)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_LIST_ID="your-sendgrid-list-id"
